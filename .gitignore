# ============================================================
# AI HeatShield - Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*

# SAFE example files must be committed
!**/.env.example

# Node / Next.js
node_modules/
.next/
out/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# TypeScript generated
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# ML / generated models
*.pkl
*.joblib

# Local databases
*.db
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
~*